# Base URL of the MediaTrust AI backend (no credentials here)
VITE_API_URL=http://localhost:5000

# Cloudinary unsigned upload preset name.
# Create one in the Cloudinary Console (Settings -> Upload -> Upload presets,
# signing mode "Unsigned"). Leave empty until then — the Upload page will
# show "Cloudinary upload preset is not configured yet."
VITE_CLOUDINARY_UPLOAD_PRESET=

# Cloudinary cloud name (not a secret; safe for the browser)
VITE_CLOUDINARY_CLOUD_NAME=ftvncyya
